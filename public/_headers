# Cloudflare Pages headers — nzamuwe.com
# CSP is ENFORCED since 2026-10-24. Pre-flight build sweep verified every
# resource origin: all scripts/images/fonts/styles self-hosted, only
# external host is plausible.io (script-src + connect-src). If a future
# dependency violates CSP, flip this line back to
# "Content-Security-Policy-Report-Only" and diagnose in devtools first.
# Docs: https://developers.cloudflare.com/pages/configuration/headers/

# Next.js immutable static chunks & fonts
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Global security headers
/*
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://plausible.io; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://plausible.io; font-src 'self'; frame-ancestors 'none'
